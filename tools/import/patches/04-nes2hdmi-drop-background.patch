# nes2hdmi: drop the $readmemb("background.txt") initializer. The file was never found by the build, and the power-up loop clears the frame buffer to grey anyway, so it had no effect; removing it avoids a misleading data file and build warning.
#
--- a/platform/video/nes2hdmi.sv
+++ b/platform/video/nes2hdmi.sv
@@ -1,3 +1,4 @@
+// Modified for retro-fpga (2026-10-21): removed $readmemb("background.txt"); the frame buffer is cleared to grey at power-up anyway. See SOURCES.md.
 // NES video and sound to HDMI converter
 // nand2mario, 2022.9
 
@@ -119,10 +120,6 @@
     mem_portB_rdata <= mem[mem_portB_addr];
 end
 
-initial begin
-    $readmemb("background.txt", mem);
-end
-
 // localparam [0:65] LOGO [0:12] = '{
 //     'b11110000110011111111001111001111111110000000000000000000000000000,
 //     'b11110000110011111111011111101111111110000000000000000000000000000,
