// SNES/NES pads. Written for retro-fpga (pins as in NESTang/SNESTang).
// Added to a core's pin file when CONTROLLERS includes "snes" (see makefile).
// Left header positions 8-13, three pins per player: player 1 at 8-10 (clock 27, latch 28,
// data 25), player 2 at 11-13 (clock 26, latch 29, data 30). These positions have no power
// pins; NESTang powers the pads from the right header (5V at position 1, GND at 2).
// Shared wiring (boards/tang-nano-20k/pinout.md): pin 25 is also HDMI CEC, pin 26 also HDMI HPD.

// SNES controller 1
IO_LOC "joy1_strb" 28;
IO_PORT "joy1_strb" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "joy1_clk" 27;
IO_PORT "joy1_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "joy1_data" 25;
IO_PORT "joy1_data" PULL_MODE=UP IO_TYPE=LVCMOS33;

// SNES controller 2
IO_LOC "joy2_strb" 29;
IO_PORT "joy2_strb" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "joy2_clk" 26;
IO_PORT "joy2_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "joy2_data" 30;
IO_PORT "joy2_data" PULL_MODE=UP IO_TYPE=LVCMOS33;
