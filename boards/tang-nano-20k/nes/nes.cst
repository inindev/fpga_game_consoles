// Onboard audio amp enable (active high), held low in every build: its I2S inputs are on
// pins 54/56 (USB gamepad 2), and unconstrained it would float high (Gowin's default for
// unused pins is input with weak pull-up), enabling the amp.
IO_LOC "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Controller pins: appended by make from boards/tang-nano-20k/controllers/. Pins a build
// leaves out stay inputs with weak pull-up (Gowin's default), the right idle state for the
// shared HDMI CEC/HPD/DDC lines. Don't set unused pins to "open drain driving ground": that
// would hold CEC and DDC low.
