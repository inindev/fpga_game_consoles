# retro-fpga build entry point.
#
#   make nes        NES core      -> build/out/nes_nano20k.{fs,bin}
#   make snes       SNES core     -> build/out/snes_nano20k.{fs,bin}
#   make usb_probe  USB port diagnostic core (prints reports on the USB-C serial port)
#                                 -> build/out/usb_probe_nano20k.{fs,bin}
#   make firmware   menu firmware -> build/out/firmware.bin
#   make sdcard     collect the built NES/SNES cores for the SD card -> build/out/sdcard/
#   make clean
#
# Controllers built into the NES and SNES cores: CONTROLLERS, any of
#   usb   USB gamepads (pins 41/42, 54/56)
#   ds2   DualShock 2 pads on Sipeed's adapters (pins 17-20, 52/53/71/72)
#   snes  SNES/NES pads (pins 25-30)
# Default: all three, OR'd per player, so any plugged-in pad works. Naming fewer only leaves
# the others out and frees their pins (boards/tang-nano-20k/controllers/*.cst). The default
# keeps the plain file name; otherwise the chosen types are appended, always in the order
# usb, ds2, snes:
#   make nes CONTROLLERS=usb          -> build/out/nes_nano20k_usb.{fs,bin}
#   make snes CONTROLLERS="usb ds2"   -> build/out/snes_nano20k_usb_ds2.{fs,bin}
#
# Gateware needs Gowin's tools (x86-64 Linux):  GOWIN_HOME=/path/to/IDE
# Firmware needs a RISC-V GCC (xPack riscv-none-elf 13.2.0-2 tested):
#   RISCV=/path/to/bin/riscv-none-elf   (prefix, without -gcc)

OUT      := build/out
GW       := build/gowin/gw.sh
RISCV    ?= riscv-none-elf
BOARD    := boards/tang-nano-20k

# Controller selection
CTRL_ALL    := usb ds2 snes
CONTROLLERS ?= $(CTRL_ALL)
CTRL_BAD    := $(filter-out $(CTRL_ALL),$(CONTROLLERS))
# the chosen types in the order of CTRL_ALL, each once
CTRL        := $(filter $(CONTROLLERS),$(CTRL_ALL))
empty       :=
space       := $(empty) $(empty)
# "" for all three, otherwise e.g. "_usb_ds2"
CTRL_SUFFIX := $(if $(filter-out $(CTRL),$(CTRL_ALL)),_$(subst $(space),_,$(CTRL)))

# Defines for each type, written to controllers.vh (included by the core's config.v)
VH_usb      := '`define USB1' '`define USB2'
VH_ds2      := '`define CONTROLLER_DS2'
VH_snes     := '`define CONTROLLER_SNES'

# Build folder and output name for the core being built ($@ = nes or snes)
CORE_DIR     = $(OUT)/$@$(CTRL_SUFFIX)
CORE_NAME    = $@_nano20k$(CTRL_SUFFIX)

# NES and SNES cores in build/out, any controller variant
CORE_BINS    = $(wildcard $(OUT)/nes_nano20k*.bin $(OUT)/snes_nano20k*.bin)

.PHONY: all nes snes usb_probe firmware sdcard clean

all: nes snes firmware

nes snes:
	$(if $(CTRL_BAD),$(error CONTROLLERS: unknown "$(CTRL_BAD)"; choose from: $(CTRL_ALL)))
	$(if $(CTRL),,$(error CONTROLLERS is empty; choose from: $(CTRL_ALL)))
	@echo "$@: controllers $(CTRL) -> $(OUT)/$(CORE_NAME).{fs,bin}"
	@mkdir -p $(CORE_DIR)
	@{ echo '// Generated by make from CONTROLLERS="$(CTRL)". Do not edit.'; \
	   printf '%s\n' $(foreach c,$(CTRL),$(VH_$(c))); } > $(CORE_DIR)/controllers.vh
	@cat $(BOARD)/$@/$@.cst $(foreach c,$(CTRL),$(BOARD)/controllers/$(c).cst) > $(CORE_DIR)/$@.cst
	cd $(CORE_DIR) && rm -rf impl && RF_NAME=$(CORE_NAME) RF_CST="$(CURDIR)/$(CORE_DIR)/$@.cst" \
	  GOWIN_HOME="$(GOWIN_HOME)" $(CURDIR)/$(GW) $(CURDIR)/build/gowin/$@_nano20k.tcl > gw_sh.log 2>&1 \
	  || { grep -E "ERROR" gw_sh.log; echo "build failed: see $(CORE_DIR)/gw_sh.log"; exit 1; }
	@# -f: gw_sh writes the bitstreams read-only, so a plain cp can't overwrite them
	cp -f $(CORE_DIR)/impl/pnr/$(CORE_NAME).fs $(CORE_DIR)/impl/pnr/$(CORE_NAME).bin $(OUT)/
	@grep -A1 -E "^ *(Logic|BSRAM) " $(CORE_DIR)/impl/pnr/$(CORE_NAME).rpt.txt | grep -E "Logic|BSRAM" || true

usb_probe:
	@mkdir -p $(OUT)/$@
	cd $(OUT)/$@ && rm -rf impl && GOWIN_HOME="$(GOWIN_HOME)" $(CURDIR)/$(GW) $(CURDIR)/build/gowin/$@_nano20k.tcl > gw_sh.log 2>&1 \
	  || { grep -E "ERROR" gw_sh.log; echo "build failed: see $(OUT)/$@/gw_sh.log"; exit 1; }
	@# -f: gw_sh writes the bitstreams read-only, so a plain cp can't overwrite them
	cp -f $(OUT)/$@/impl/pnr/$@_nano20k.fs $(OUT)/$@/impl/pnr/$@_nano20k.bin $(OUT)/
	@grep -A1 -E "^ *(Logic|BSRAM) " $(OUT)/$@/impl/pnr/$@_nano20k.rpt.txt | grep -E "Logic|BSRAM" || true

firmware:
	$(MAKE) -C firmware RISCV=$(RISCV)
	@mkdir -p $(OUT) && cp firmware/firmware.bin $(OUT)/

sdcard:
	$(if $(CORE_BINS),,$(error no NES/SNES cores in $(OUT): run make nes and/or make snes first))
	@mkdir -p $(OUT)/sdcard/cores
	cp $(CORE_BINS) $(OUT)/sdcard/cores/
	@echo "Copy $(OUT)/sdcard/cores/ to the root of the SD card; use menu '2) Select core'."

clean:
	rm -rf $(OUT)
	$(MAKE) -C firmware RISCV=$(RISCV) clean
